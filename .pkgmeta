package-as: Hg_Rebirth

manual-changelog:
    filename: changelog.md
    markup-type: markdown

enable-nolib-creation: no

move-folders:
    Hg_Rebirth/Hg_Rebirth: Hg_Rebirth
    Hg_Rebirth/Hg_Rebirth_Aura: Hg_Rebirth_Aura
    Hg_Rebirth/Hg_Rebirth_Castbars: Hg_Rebirth_Castbars
    Hg_Rebirth/Hg_Rebirth_Focus: Hg_Rebirth_Focus
    Hg_Rebirth/Hg_Rebirth_Focus_Aura: Hg_Rebirth_Focus_Aura
    Hg_Rebirth/Hg_Rebirth_Focus_Target: Hg_Rebirth_Focus_Target
    Hg_Rebirth/Hg_Rebirth_Party: Hg_Rebirth_Party
    Hg_Rebirth/Hg_Rebirth_Party_Pet: Hg_Rebirth_Party_Pet
    Hg_Rebirth/Hg_Rebirth_Party_Target: Hg_Rebirth_Party_Target
    Hg_Rebirth/Hg_Rebirth_Player: Hg_Rebirth_Player
    Hg_Rebirth/Hg_Rebirth_Player_Aura: Hg_Rebirth_Player_Aura
    Hg_Rebirth/Hg_Rebirth_Player_Pet: Hg_Rebirth_Player_Pet
    Hg_Rebirth/Hg_Rebirth_Target: Hg_Rebirth_Target
    Hg_Rebirth/Hg_Rebirth_Target_Aura: Hg_Rebirth_Target_Aura
    Hg_Rebirth/Hg_Rebirth_Target_Target: Hg_Rebirth_Target_Target

ignore:
    - Tests
    - "inv_babymurlo3frost.jpg"

embedded-libraries:
    - libstub
    - callbackhandler-1.0

tools-used:
    - libdatabroker-1.1
